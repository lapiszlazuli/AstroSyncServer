# ─── Entorno ──────────────────────────────────────────────
NODE_ENV=development
PORT=3000

# ─── Base de datos MySQL (XAMPP) ──────────────────────────
DB_HOST=localhost
DB_PORT=3306
DB_NAME=astrosync
DB_USER=root
DB_PASS=
DB_DIALECT=mysql

# ─── JWT ──────────────────────────────────────────────────
# Cambia esto por una cadena aleatoria larga y secreta
JWT_SECRET=cambia_esto_por_algo_muy_secreto_y_largo_2026
JWT_EXPIRES_IN=7d

# ─── CORS ─────────────────────────────────────────────────
# URLs permitidas para conectarse (web app)
ALLOWED_ORIGINS=*

# ─── Servidor en producción ───────────────────────────────
# Cuando despliegues en tu host real, cambia estas vars:
# DB_HOST=tu_host_de_db
# DB_USER=tu_usuario
# DB_PASS=tu_contraseña
# ALLOWED_ORIGINS=https://tu-dominio.com
